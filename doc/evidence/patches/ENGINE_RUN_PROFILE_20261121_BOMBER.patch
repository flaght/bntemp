+    def set_run_profiling(self, enabled=True):
+        """Enable/reset optional diagnostics before processing the first event.
+
+        Disabling profiling performs no per-stage wall-clock reads. Enabling it
+        adds measurement overhead and never changes simulated market time.
+        """
+        if self._iteration != 0:
