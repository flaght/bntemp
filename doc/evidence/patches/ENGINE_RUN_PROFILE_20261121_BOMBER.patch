+    def get_run_profile(self):
+        """Return detached cumulative diagnostics, including failed run totals.
+
+        Child stages are disjoint caller scopes, inclusive of callbacks they
+        invoke. Stage counters count completed scopes. The total also includes
+        exceptions and measurement/control overhead. add_data/clear_data/end
+        are outside this profile. Reading does not reset counters.
+        """
+        cdef int i
+        timings = {
+            name: {"seconds": self._run_profile_seconds[i],
+                   "calls": self._run_profile_calls[i]}
+            for i, name in enumerate(_RUN_PROFILE_NAMES)
+        }
+        accounted = sum(self._run_profile_seconds[i] for i in range(1, 15))
+        return {
+            "revision": RUN_PROFILING_REVISION,
+            "enabled": bool(self._run_profile_enabled),
+            "timing_semantics": "wall_seconds; children_disjoint_inclusive_of_callbacks; do_not_add_total",
+            "scope": "_run only; excludes add_data, clear_data and end; diagnostic overhead included",
+            "timings": timings,
+            "counters": {
+                "run_calls": self._run_profile_calls[RP_TOTAL],
+                "data_events": self._run_profile_calls[RP_EXCHANGE],
+                "data_timestamp_groups": self._run_profile_timestamp_groups,
+                "clock_advances": self._run_profile_calls[RP_ADVANCE_TIME],
+            },
+            "unattributed_seconds": max(0.0, self._run_profile_seconds[RP_TOTAL] - accounted),
+        }
+
+    cdef double _record_run_profile(self, int stage, double started):
+        cdef double now = perf_counter()
+        self._run_profile_seconds[stage] += now - started
+        self._run_profile_calls[stage] += 1
+        return now
