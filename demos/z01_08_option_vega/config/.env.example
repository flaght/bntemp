# 复制为同目录.env，填写z01新账号。不得沿用原账号CTP_ACCOUNT_ID或提交密码。
CTP_BROKER_ID=9999
CTP_ACCOUNT_ID=
CTP_PASSWORD=
CTP_TD_ADDRESS=
CTP_APP_ID=
CTP_AUTH_CODE=
CTP_PRODUCTION_MODE=true
CTP_TD_FLOW_PATH=/tmp/bomber-z01-option-vega-td
CTP_MD_FLOW_PATH=/tmp/bomber-z01-option-vega-md

# 可沿用原08可用的DDB连接；这些字段与CTP交易账号无关。
# 如原环境还有DDB_REFERENCE_*或其它DDB_*变量，一并复制到本.env。
DDB_MARKET_HOST=
DDB_MARKET_PORT=
DDB_MARKET_USERNAME=
DDB_MARKET_PASSWORD=
DDB_REFERENCE_HOST=
DDB_REFERENCE_PORT=
DDB_REFERENCE_USERNAME=
DDB_REFERENCE_PASSWORD=

# mCFFEX所在实时Tick节点，与Bar节点分开配置；不会回退DDB_*或DDB_MARKET_*。
DDB_TICK_HOST=
DDB_TICK_PORT=8848
DDB_TICK_USERNAME=
DDB_TICK_PASSWORD=
DDB_TICK_STREAMING_PORT=0
