# 将占位地址和凭据替换为实际值，放入项目 .env 或导出到运行环境。
# 行情服务器：实时分钟流、历史分钟以及指数 DFS 查询。
DDB_MARKET_HOST=market-db.example
DDB_MARKET_PORT=8848
DDB_MARKET_USERNAME=market_reader
DDB_MARKET_PASSWORD=replace-with-market-password
DDB_MARKET_STREAMING_PORT=0
# SSL 开关用于历史/指数 DFS 查询；流订阅沿用现有 SDK 传输设置。
DDB_MARKET_ENABLE_SSL=false

# 基础信息服务器：主力、合约条款、因子及交易时段。
DDB_REFERENCE_HOST=reference-db.example
DDB_REFERENCE_PORT=8848
DDB_REFERENCE_USERNAME=reference_reader
DDB_REFERENCE_PASSWORD=replace-with-reference-password
DDB_REFERENCE_ENABLE_SSL=false
DDB_REFERENCE_DATABASE=dfs://bomber_daily

# Hybrid 的静态交易时段；与 bomber_daily 共用上述 REFERENCE 连接。
DDB_TRADING_HOURS_DATABASE=dfs://bomber_static
DDB_TRADING_HOURS_TABLE=fut_trading_session

# 行情流表以及历史 database/table/columns 仍在原 market/history 配置中声明。
